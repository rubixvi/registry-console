{
  "name": "rubix-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "pnpm biome lint",
    "lint:fix": "pnpm biome lint --write",
    "format": "pnpm biome format --write",
    "format:check": "pnpm biome format",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test",
    "check:fix": "pnpm run lint:fix && pnpm run typecheck && pnpm test",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:container": "node scripts/container-smoke.mjs",
    "test:integration": "node --import tsx scripts/integration.ts",
    "password:hash": "node scripts/password-hash.mjs",
    "secret:encrypt": "node --env-file=.env scripts/encrypt-secret.mjs",
    "setup": "node scripts/setup.mjs",
    "image:build": "node scripts/build-image.mjs",
    "image:publish": "node scripts/publish-image.mjs",
    "security:reset": "node --env-file=.env scripts/reset-security.mjs"
  },
  "engines": {
    "node": "24.x || 25.x",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ldapts": "9.2.0",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.11.2"
}
