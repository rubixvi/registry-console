# Docker Compose Image
REGISTRY_CONSOLE_IMAGE=ghcr.io/your-owner/registry-console:1.0.0

# Production requires HTTPS except on loopback hosts.
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data

AUTH_USERNAME=admin
# Generate with pnpm run password:hash.
AUTH_PASSWORD_HASH='scrypt$32768$8$1$REPLACE_WITH_GENERATED_HASH'

# Optional immutable account UUID.
# AUTH_USER_ID=00000000-0000-4000-8000-000000000001

# Optional multiple accounts.
# AUTH_USERS_JSON='[{"id":"00000000-0000-4000-8000-000000000001","username":"admin","passwordHash":"REPLACE_WITH_ADMIN_SCRYPT_HASH","role":"admin"},{"id":"00000000-0000-4000-8000-000000000002","username":"reader","passwordHash":"REPLACE_WITH_VIEWER_SCRYPT_HASH","role":"viewer"}]'

# Use 32 random bytes encoded as 64 hexadecimal characters and retain securely.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Session lifetime in hours, from 1 to 24.
SESSION_HOURS=8

# Enable only behind a proxy that overwrites X-Forwarded-For and blocks direct access.
TRUST_PROXY=false

# Initial workspace name and name used for passkey.
BRAND_NAME=Registry Console

# Approved registry origins, comma separated.
REGISTRY_ALLOWED_ORIGINS=https://registry.example.com

# Default public address for copied pull commands. Connections can override this.
PULL_URL=

# Default tag order: natural-asc, natural-desc, alpha-asc, or alpha-desc.
TAGLIST_ORDER=natural-asc

# Additional image-config labels to display, comma separated.
# HISTORY_CUSTOM_LABELS=com.example.build-url,com.example.team

# Approved external Bearer token-service origins, comma separated.
REGISTRY_TOKEN_ORIGINS=

# Permit HTTP connections to approved registries.
ALLOW_HTTP_REGISTRIES=false

# Optional initial registry connection.
# REGISTRY_URL=https://registry.example.com
# REGISTRY_NAME=Production
# REGISTRY_USERNAME=robot

# Generate the encrypted registry password with pnpm run secret:encrypt.
# REGISTRY_PASSWORD_ENCRYPTED=v1.IV.TAG.CIPHERTEXT

# Prevent manifest deletion through the initial connection.
# REGISTRY_READ_ONLY=false

# Approved HTTPS blob/CDN origins. Authorization is stripped on redirects.
REGISTRY_BLOB_ORIGINS=

# Docker Hub requires registry-1.docker.io and hub.docker.com in REGISTRY_ALLOWED_ORIGINS.
# Add https://auth.docker.io to REGISTRY_TOKEN_ORIGINS.
# Approve its exact configuration-blob CDN origin in REGISTRY_BLOB_ORIGINS.

# Optional LDAP directory authentication. Configure explicit LDAP users in AUTH_USERS_JSON.
LDAP_ENABLED=false
LDAP_URL=
LDAP_STARTTLS=false
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD_ENCRYPTED=
LDAP_USER_FILTER=(uid={username})
LDAP_SESSION_MINUTES=15

# Optional Trivy CLI. The standard application image does not bundle Trivy.
# Enable scanning separately for each connection in its edit dialog.
TRIVY_ENABLED=false
TRIVY_PATH=/usr/local/bin/trivy
TRIVY_TIMEOUT_SECONDS=180
TRIVY_SCANS_PER_HOUR=16
